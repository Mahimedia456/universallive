PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER ONLY. Never place this key in the Android/iOS app.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
CORS_ORIGINS=*

# Phase 27 secure destination credential encryption (server only)
STREAM_SECRET_MASTER_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Phase 29 internal admin monitoring API key
ADMIN_API_KEY=replace-with-a-long-random-admin-key
