PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=*

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER ONLY. Never place this key in Android/iOS builds.
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY

# Universal Live-owned authentication. Supabase Auth is NOT used.
AUTH_MODE=universallive-db
JWT_ACCESS_SECRET=replace-with-64-random-characters-minimum
JWT_RESET_SECRET=replace-with-a-different-64-random-characters
OTP_PEPPER=replace-with-another-64-random-characters
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=10
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=45

# Use console locally; production validation requires smtp.
EMAIL_MODE=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@universallive.app
SMTP_FROM_NAME=Universal Live

# Existing backend secrets
STREAM_SECRET_MASTER_KEY=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Android push notifications (FCM HTTP v1). Values come from a Firebase service account.
FIREBASE_PROJECT_ID=universallive-d5d90
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@universallive-d5d90.iam.gserviceaccount.com
# Keep escaped newlines in .env, for example: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# Optional Google Play billing server verification.
GOOGLE_PLAY_PACKAGE_NAME=com.universallive.app
