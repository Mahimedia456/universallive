{
  "expo": {
    "name": "SizeME",
    "slug": "sizeme",
    "version": "0.22.2",
    "orientation": "portrait",
    "scheme": "sizeme",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/generated/app-icon-original.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sizeme.app",
      "buildNumber": "22"
    },
    "android": {
      "package": "com.sizeme.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/generated/app-icon-original.png",
        "backgroundColor": "#100D13",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 22
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/generated/app-icon-original.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFAFD",
          "image": "./assets/brand/generated/logo-light-original.png",
          "dark": {
            "image": "./assets/brand/generated/logo-dark-original.png",
            "backgroundColor": "#100D13"
          },
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SizeME to use your camera for guided body measurement scans.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
